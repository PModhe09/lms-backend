# Copy to .env for local runs: cp .env.example .env
# docker-compose.yml overrides MONGO_URI and S3_ENDPOINT with in-network hostnames.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Mongo must be a replica set (transactions). directConnection=true for a single node.
MONGO_URI=mongodb://localhost:27017/lms?directConnection=true

# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
JWT_EXPIRES_IN_SECONDS=86400
# true in production (HTTPS). false locally so the cookie works on http://localhost.
COOKIE_SECURE=false

# Salary slip storage. s3 = any S3-compatible store (SeaweedFS locally, R2/S3); blob = private Vercel Blob
# (on Vercel; credentials come from the connected store via BLOB_READ_WRITE_TOKEN / OIDC).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=lms-salary-slips
S3_ACCESS_KEY_ID=lms-local-access
S3_SECRET_ACCESS_KEY=lms-local-secret-key
S3_FORCE_PATH_STYLE=true
# Host the browser uses to open presigned slip URLs (Docker: the API reaches storage as http://storage:8333).
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Create the bucket at boot if missing. Local only; leave false in production.
S3_AUTO_CREATE_BUCKET=true
